# AutoEdit Pro — Environment Variables
# Copy to .env and fill in your values
# All settings can also be set in config/default.yaml or config/secrets.yaml

# ============================================================
# API KEYS (Free tiers available)
# ============================================================

# Pexels - https://www.pexels.com/api/
AUTOEDIT__APIS__PEXELS__API_KEY=your_pexels_key_here

# Pixabay - https://pixabay.com/api/docs/
AUTOEDIT__APIS__PIXABAY__API_KEY=your_pixabay_key_here

# Unsplash - https://unsplash.com/developers
AUTOEDIT__APIS__UNSPLASH__ACCESS_KEY=your_unsplash_access_key
AUTOEDIT__APIS__UNSPLASH__SECRET_KEY=your_unsplash_secret_key

# Freesound - https://freesound.org/docs/api/
AUTOEDIT__APIS__FREESOUND__API_KEY=your_freesound_key_here

# Hugging Face - https://huggingface.co/settings/tokens
AUTOEDIT__HUGGINGFACE__TOKEN=your_hf_token_here

# GitHub - Personal access token (public_repo scope)
AUTOEDIT__GITHUB__TOKEN=your_github_token_here

# YouTube Data API - https://console.cloud.google.com/apis/library/youtube.googleapis.com
AUTOEDIT__YOUTUBE__API_KEY=your_youtube_key_here

# ============================================================
# OLLAMA
# ============================================================

# Ollama host (default: http://localhost:11434)
AUTOEDIT__MODELS__LLM__HOST=http://localhost:11434

# ============================================================
# HARDWARE OVERRIDES
# ============================================================

# Force hardware profile: rtx_2050_4gb, rtx_3060_12gb, rtx_4090_24gb, apple_silicon, cpu_only
AUTOEDIT__HARDWARE_PROFILE=rtx_2050_4gb

# GPU memory fraction (0.1-1.0)
AUTOEDIT__HARDWARE__GPU__MEMORY_FRACTION=0.85

# LLM layers to offload to CPU (for low VRAM)
AUTOEDIT__HARDWARE__GPU__OFFLOAD_LAYERS=20

# CPU threads
AUTOEDIT__HARDWARE__CPU_THREADS=8

# ============================================================
# MODEL SETTINGS
# ============================================================

# LLM model (must be pulled in Ollama)
AUTOEDIT__MODELS__LLM__MODEL=qwen2.5:7b-instruct-q4_K_M

# LLM temperature (0.0-2.0)
AUTOEDIT__MODELS__LLM__TEMPERATURE=0.2

# Whisper model
AUTOEDIT__MODELS__WHISPER__MODEL=large-v3-turbo

# ============================================================
# PIPELINE SETTINGS
# ============================================================

# Auto-review (skip UI)
AUTOEDIT__PIPELINE__AUTO_REVIEW=false

# Skill pack
AUTOEDIT__SKILLS__DEFAULT_PACK=educational_clean

# Learning enabled
AUTOEDIT__PIPELINE__LEARNING__ENABLED=true

# Viral scoring enabled
AUTOEDIT__PIPELINE__SCORING__ENABLED=true

# ============================================================
# LOGGING
# ============================================================

# Log level: DEBUG, INFO, WARNING, ERROR
AUTOEDIT__LOGGING__LEVEL=INFO

# Log format: json, console
AUTOEDIT__LOGGING__FORMAT=json