# AutoEdit Pro — Secrets Configuration
# COPY THIS FILE TO config/secrets.yaml AND FILL IN YOUR KEYS
# NEVER COMMIT secrets.yaml TO GIT (it's in .gitignore)

# ============================================================
# FREE API KEYS (All have generous free tiers)
# ============================================================

# Pexels — https://www.pexels.com/api/
# Free: 200 requests/hour, 20,000/month
pexels:
  api_key: "YOUR_PEXELS_API_KEY_HERE"

# Pixabay — https://pixabay.com/api/docs/
# Free: 100 requests/minute, 5000/day
pixabay:
  api_key: "YOUR_PIXABAY_API_KEY_HERE"

# Unsplash — https://unsplash.com/developers
# Free: 50 requests/hour (demo), 5000/hour (approved)
unsplash:
  access_key: "YOUR_UNSPLASH_ACCESS_KEY_HERE"
  secret_key: "YOUR_UNSPLASH_SECRET_KEY_HERE"

# Freesound — https://freesound.org/docs/api/
# Free: 100 requests/day (after account verification)
freesound:
  api_key: "YOUR_FREESOUND_API_KEY_HERE"
  # OAuth credentials for higher limits (optional)
  client_id: ""
  client_secret: ""

# ============================================================
# OPTIONAL: OLLAMA CONFIGURATION
# ============================================================
# Only needed if running Ollama on remote host or with auth
ollama:
  host: "http://localhost:11434"
  # api_key: ""  # If using authenticated Ollama

# ============================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================

# Hugging Face — for model downloads, skill discovery
# Free token at https://huggingface.co/settings/tokens
huggingface:
  token: "YOUR_HF_TOKEN_HERE"

# GitHub — for skill discovery from repos
# Personal access token (classic) with public_repo scope
github:
  token: "YOUR_GITHUB_TOKEN_HERE"

# Reddit — for skill discovery from discussions
# Create app at https://www.reddit.com/prefs/apps
reddit:
  client_id: "YOUR_REDDIT_CLIENT_ID"
  client_secret: "YOUR_REDDIT_CLIENT_SECRET"
  user_agent: "AutoEdit-Pro/0.1 by u/yourusername"

# YouTube Data API — for audio library, trend analysis
# Enable at https://console.cloud.google.com/apis/library/youtube.googleapis.com
youtube:
  api_key: "YOUR_YOUTUBE_API_KEY_HERE"
  oauth_client_id: ""
  oauth_client_secret: ""

# ============================================================
# OPTIONAL: NOTIFICATIONS & MONITORING
# ============================================================

# Discord webhook for completion notifications
discord:
  webhook_url: "https://discord.com/api/webhooks/YOUR_WEBHOOK_HERE"

# Slack webhook
slack:
  webhook_url: "https://hooks.slack.com/services/YOUR_WEBHOOK_HERE"

# Email (SMTP) for reports
email:
  smtp_host: "smtp.gmail.com"
  smtp_port: 587
  username: "your_email@gmail.com"
  password: "YOUR_APP_PASSWORD"
  from_address: "autoedit@yourdomain.com"
  to_addresses:
    - "your_email@gmail.com"

# ============================================================
# OPTIONAL: CLOUD STORAGE (for asset backup/sync)
# ============================================================

# AWS S3 / compatible
s3:
  enabled: false
  endpoint_url: "https://s3.amazonaws.com"
  region: "us-east-1"
  access_key_id: "YOUR_ACCESS_KEY"
  secret_access_key: "YOUR_SECRET_KEY"
  bucket: "autoedit-assets"

# Google Cloud Storage
gcs:
  enabled: false
  project_id: "your-project-id"
  credentials_path: "./config/gcs-credentials.json"
  bucket: "autoedit-assets"

# ============================================================
# DATABASE (if using external DB instead of SQLite)
# ============================================================

# PostgreSQL (for multi-user or production)
postgres:
  enabled: false
  host: "localhost"
  port: 5432
  database: "autoedit"
  username: "autoedit"
  password: "YOUR_DB_PASSWORD"
  pool_size: 5

# Redis (for caching, queue)
redis:
  enabled: false
  host: "localhost"
  port: 6379
  password: ""
  db: 0